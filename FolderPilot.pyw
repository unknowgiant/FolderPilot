                            continue
                        items.append({"name": e.name, "is_dir": e.is_dir(follow_symlinks=False),
                                      "size": st.st_size if not e.is_dir(follow_symlinks=False) else 0,
                                      "mtime": st.st_mtime, "ext": os.path.splitext(e.name)[1].lstrip(".").lower(),
                                      "hidden": hidden})
                    except OSError:
                        continue
            return {"ok": True, "path": path, "items": items}
