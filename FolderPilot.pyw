class _FILETIME(ctypes.Structure):
    _fields_ = [("dwLowDateTime", ctypes.c_uint), ("dwHighDateTime", ctypes.c_uint)]

class Everything:
    REQ_NAME, REQ_PATH = 0x1, 0x2
    REQ_SIZE, REQ_DATE_MODIFIED = 0x10, 0x40
    def __init__(self):
        self.lock = threading.Lock()
        self.dll = None
        self.dll_path = None
        self.major = self.minor = 0
        self.last_error = ""
    def _extract_dll(self):
        candidates = [
            os.path.join(os.path.dirname(os.path.abspath(__file__)), "Everything64.dll"),
            os.path.join(APP_DIR, "bin", "Everything64.dll"),
        ]
        for c in candidates:
            if os.path.isfile(c):
                return c
        if DLL_B64 and DLL_B64 != "__DLL_B64__":
            try:
                dst = candidates[1]
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                with open(dst, "wb") as f:
                    f.write(base64.b64decode(DLL_B64))
                return dst
            except Exception as e:
                self.last_error = f"DLL 解压失败: {e}"
        return None
    def connect(self):
        if self.dll:
            return True
        p = self._extract_dll()
        if not p:
            self.last_error = self.last_error or "未找到 Everything64.dll"
            return False
        try:
            dll = ctypes.WinDLL(p)
            dll.Everything_SetSearchW.argtypes = [ctypes.c_wchar_p]
            dll.Everything_SetMax.argtypes = [ctypes.c_uint]
            dll.Everything_SetRequestFlags.argtypes = [ctypes.c_uint]
            dll.Everything_QueryW.argtypes = [ctypes.c_int]
            dll.Everything_QueryW.restype = ctypes.c_int
            dll.Everything_GetNumResults.restype = ctypes.c_uint
            dll.Everything_GetResultFileNameW.restype = ctypes.c_wchar_p
            dll.Everything_GetResultPathW.restype = ctypes.c_wchar_p
            dll.Everything_GetResultSize.argtypes = [ctypes.c_uint, ctypes.POINTER(ctypes.c_ulonglong)]
            dll.Everything_GetResultDateModified.argtypes = [ctypes.c_uint, ctypes.POINTER(_FILETIME)]
            dll.Everything_GetMajorVersion.restype = ctypes.c_uint
            dll.Everything_GetMinorVersion.restype = ctypes.c_uint
            self.dll = dll
            self.dll_path = p
            try:
                self.major = dll.Everything_GetMajorVersion()
                self.minor = dll.Everything_GetMinorVersion()
            except Exception:
                self.major = self.minor = 0
            return True
        except OSError as e:
            self.last_error = f"加载 DLL 失败: {e}"
            return False
    @property
    def pinyin_ok(self):
        return self.major >= 1 and self.minor >= 5
    def version_str(self):
        return f"{self.major}.{self.minor}" if self.major else "1.x"
    def _query_raw(self, q, maxn):
        d = self.dll
        d.Everything_SetSearchW(q)
        d.Everything_SetMax(int(maxn))
        d.Everything_SetRequestFlags(self.REQ_NAME | self.REQ_PATH | self.REQ_SIZE | self.REQ_DATE_MODIFIED)
        if not d.Everything_QueryW(True):
            err = d.Everything_GetLastError()
            raise RuntimeError({1: "内存不足", 2: "Everything 未运行"}.get(err, f"查询失败 (code {err})"))
        out = []
        n = d.Everything_GetNumResults()
        for i in range(n):
            name = d.Everything_GetResultFileNameW(i)
            path = d.Everything_GetResultPathW(i)
            sz = ctypes.c_ulonglong(0)
            ft = _FILETIME()
            d.Everything_GetResultSize(i, ctypes.byref(sz))
            d.Everything_GetResultDateModified(i, ctypes.byref(ft))
            raw = (ft.dwHighDateTime << 32) | ft.dwLowDateTime  # 100ns since 1601
            mtime = raw / 1e7 - FILETIME_UNIX_OFFSET if raw > 10**14 else 0
            out.append({"name": name or "", "path": path or "",
                        "is_dir": False, "size": int(sz.value), "mtime": mtime})
        return out
    def search(self, q, maxn):
        with self.lock:
            if not self.dll and not self.connect():
                raise RuntimeError(self.last_error or "Everything SDK 不可用")
            res = self._query_raw(q, maxn)
            # 文件夹标记：按系统属性判断
            for r in res:
                full = os.path.join(r["path"], r["name"])
                try:
                    attr = ctypes.windll.kernel32.GetFileAttributesW(full)
                    if attr != -1 and attr & 0x10:
                        r["is_dir"] = True
                        r["size"] = 0
                except Exception:
                    pass
            return res

EV = Everything()

def _http_probe():
    """探测 Everything HTTP 服务端口。"""
    ports = []
    p = CFG["settings"].get("http_port")
    if p:
        ports.append(int(p))
    ports += [80, 88]
    for port in ports:
        try:
            s = socket.create_connection(("127.0.0.1", port), timeout=0.4)
            s.close()
            return port
        except OSError:
            continue
    return None

def _http_search(q, maxn):
    import urllib.request
    port = _http_probe()
    if port is None:
        raise RuntimeError("Everything HTTP 服务未开启（选项→HTTP 服务器）")
    url = f"http://127.0.0.1:{port}/?json=1&s={urllib.request.quote(q)}&n={int(maxn)}&path_column=1&size_column=1&date_modified_column=1"
    with urllib.request.urlopen(url, timeout=8) as resp:
        data = json.loads(resp.read().decode("utf-8", "replace"))
    out = []
    for it in data.get("results", []):
        dm = it.get("date_modified") or 0
        if dm > 1e11:  # FILETIME 秒（1601 纪元）
            dm = dm - FILETIME_UNIX_OFFSET
        out.append({"name": it.get("name", ""), "path": it.get("path", ""),
                    "is_dir": it.get("type") == "folder",
                    "size": int(it.get("size") or 0), "mtime": float(dm or 0)})
    return out

def _local_fallback_search(filters, kw, base_dir, maxn):
    """无 Everything 时的兜底：从当前目录向下 BFS。"""
    start = base_dir or os.path.expanduser("~")
    pats = [w.lower() for w in re.split(r"\s+", kw.strip()) if w] if kw else []
    exts = None
    m = re.search(r"ext:([\w;]+)", filters or "")
    if m:
        exts = {e.lower() for e in m.group(1).split(";") if e}
    results, t0 = [], time.time()
    for root, dirs, files in os.walk(start):
        if time.time() - t0 > 4 or len(results) >= maxn:
            break
        depth = root[len(start):].count(os.sep)
        if depth >= 5:
            dirs[:] = []
            continue
        for n in dirs + files:
            if len(results) >= maxn:
                break
            if pats and not all(w in n.lower() for w in pats):
                continue
            if exts and not n.lower().endswith(tuple("." + e for e in exts)):
                continue
            full = os.path.join(root, n)
            try:
                st = os.stat(full)
                results.append({"name": n, "path": root, "is_dir": os.path.isdir(full),
                                "size": st.st_size if os.path.isfile(full) else 0, "mtime": st.st_mtime})
            except OSError:
                pass
        dirs[:] = [d for d in dirs if not d.startswith((".", "$"))]
    return results

# ─────────────────────── Win32 助手 ───────────────────────
class SHFILEOPSTRUCTW(ctypes.Structure):
    _fields_ = [("hwnd", wintypes.HWND), ("wFunc", ctypes.c_uint),
                ("pFrom", ctypes.c_wchar_p), ("pTo", ctypes.c_wchar_p),
                ("fFlags", ctypes.c_ushort), ("fAnyOperationsAborted", wintypes.BOOL),
                ("hNameMappings", ctypes.c_void_p), ("lpszProgressTitle", ctypes.c_wchar_p)]

def trash_files(paths):
    FO_DELETE = 3
    FOF_ALLOWUNDO, FOF_NOCONFIRMATION, FOF_SILENT, FOF_NOERRORUI = 0x40, 0x10, 0x4, 0x400
    op = SHFILEOPSTRUCTW()
    op.hwnd = None
    op.wFunc = FO_DELETE
    op.pFrom = "\x00".join(paths) + "\x00\x00"
    op.pTo = None
    op.fFlags = FOF_ALLOWUNDO | FOF_NOCONFIRMATION | FOF_SILENT | FOF_NOERRORUI
    res = ctypes.windll.shell32.SHFileOperationW(ctypes.byref(op))
    if res != 0:
        raise RuntimeError(f"移入回收站失败 (code {res})")
    return True

def _clip_fns():
    """初始化 64 位安全的剪贴板/全局内存函数签名（避免句柄截断）。"""
    u32, k32 = ctypes.windll.user32, ctypes.windll.kernel32
    u32.OpenClipboard.restype = ctypes.c_int
    u32.OpenClipboard.argtypes = [ctypes.c_void_p]
    u32.CloseClipboard.restype = ctypes.c_int
    u32.EmptyClipboard.restype = ctypes.c_int
    u32.IsClipboardFormatAvailable.restype = ctypes.c_int
    u32.IsClipboardFormatAvailable.argtypes = [ctypes.c_uint]
    u32.RegisterClipboardFormatW.restype = ctypes.c_uint
    u32.RegisterClipboardFormatW.argtypes = [ctypes.c_wchar_p]
    u32.GetClipboardData.restype = ctypes.c_void_p
    u32.GetClipboardData.argtypes = [ctypes.c_uint]
    u32.SetClipboardData.restype = ctypes.c_void_p
    u32.SetClipboardData.argtypes = [ctypes.c_uint, ctypes.c_void_p]
    k32.GlobalAlloc.restype = ctypes.c_void_p
    k32.GlobalAlloc.argtypes = [ctypes.c_uint, ctypes.c_size_t]
    k32.GlobalLock.restype = ctypes.c_void_p
    k32.GlobalLock.argtypes = [ctypes.c_void_p]
    k32.GlobalUnlock.restype = ctypes.c_int
    k32.GlobalUnlock.argtypes = [ctypes.c_void_p]
    k32.GlobalSize.restype = ctypes.c_size_t
    k32.GlobalSize.argtypes = [ctypes.c_void_p]
    k32.GlobalFree.restype = ctypes.c_void_p
    k32.GlobalFree.argtypes = [ctypes.c_void_p]
    return u32, k32

def _cf_hdrop_write(paths, move=False):
    """写文件列表到剪贴板；move=True 时附加 Preferred DropEffect（剪切语义，资源管理器粘贴会移动）。"""
    u32, k32 = _clip_fns()
    CF_HDROP, GMEM_MOVEABLE = 15, 0x0002
    payload = "\x00".join(paths) + "\x00\x00"
    data = payload.encode("utf-16-le")
    header = struct.pack("IIIii", 20, 0, 0, 0, 1)  # pFiles=20, pt(0,0), fNC=0, fWide=1
    blob = header + data
    if not u32.OpenClipboard(0):
        raise RuntimeError("剪贴板被占用")
    try:
        u32.EmptyClipboard()
        h = k32.GlobalAlloc(GMEM_MOVEABLE, len(blob))
        p = k32.GlobalLock(h)
        ctypes.memmove(p, blob, len(blob))
        k32.GlobalUnlock(h)
        u32.SetClipboardData(CF_HDROP, h)
        # Preferred DropEffect：1=复制 2=移动（Windows 标准格式）
        fmt = u32.RegisterClipboardFormatW("Preferred DropEffect")
        if fmt:
            dword = struct.pack("I", 2 if move else 1)
            hd = k32.GlobalAlloc(GMEM_MOVEABLE, 4)
            pd = k32.GlobalLock(hd)
            ctypes.memmove(pd, dword, 4)
            k32.GlobalUnlock(hd)
            u32.SetClipboardData(fmt, hd)
    finally:
        u32.CloseClipboard()

def _cf_text_write(text):
    """写纯文本到剪贴板（CF_UNICODETEXT）。剪贴板可能被其他程序短暂占用，OpenClipboard 带重试。"""
    u32, k32 = _clip_fns()
    CF_UNICODETEXT, GMEM_MOVEABLE = 13, 0x0002
    data = text.encode("utf-16-le") + b"\x00\x00"
    for _ in range(6):
        if u32.OpenClipboard(0):
            try:
                u32.EmptyClipboard()
                h = k32.GlobalAlloc(GMEM_MOVEABLE, len(data))
                p = k32.GlobalLock(h)
                if not p:
                    k32.GlobalFree(h)
                    raise RuntimeError("GlobalLock 失败")
                ctypes.memmove(p, data, len(data))
                k32.GlobalUnlock(h)
                if not u32.SetClipboardData(CF_UNICODETEXT, h):
                    k32.GlobalFree(h)  # 失败时系统未接管内存，需自行释放
                    raise RuntimeError("SetClipboardData 失败")
                return True  # 成功后内存归系统所有，勿再释放
            finally:
                u32.CloseClipboard()
        time.sleep(0.04)
    raise RuntimeError("剪贴板被其他程序占用，请重试")

def _cf_hdrop_read():
    """读文件列表；返回 (paths, move)，move 取自 Preferred DropEffect。
    注意：文件列表与 DropEffect 分两次剪贴板会话读取——同一会话内
    GlobalLock 过数据后再 GetClipboardData 会返回 NULL（实测行为）。"""
    u32, k32 = _clip_fns()
    CF_HDROP = 15
    if not u32.IsClipboardFormatAvailable(CF_HDROP):
        return [], False
    paths, move = [], False
    # 会话 1：读文件列表
    if u32.OpenClipboard(0):
        try:
            h = u32.GetClipboardData(CF_HDROP)
            if h:
                p = k32.GlobalLock(h)
                if p:
                    size = k32.GlobalSize(h)
                    buf = ctypes.string_at(p, size)
                    off = struct.unpack_from("I", buf, 0)[0]
                    raw = buf[off:].decode("utf-16-le", "replace")
                    paths = [s for s in raw.split("\x00") if s]
                    k32.GlobalUnlock(h)
        finally:
            u32.CloseClipboard()
    # 会话 2：读 Preferred DropEffect
    fmt = u32.RegisterClipboardFormatW("Preferred DropEffect")
    if fmt and u32.IsClipboardFormatAvailable(fmt) and u32.OpenClipboard(0):
        try:
            hd = u32.GetClipboardData(fmt)
            if hd:
                pd = k32.GlobalLock(hd)
                if pd:
                    val = struct.unpack_from("I", ctypes.string_at(pd, 4), 0)[0]
                    k32.GlobalUnlock(hd)
                    move = val == 2
        finally:
            u32.CloseClipboard()
    return paths, move

def get_drives():
    bitmask = ctypes.windll.kernel32.GetLogicalDrives()
    out = []
    letters = [chr(65 + i) for i in range(26) if bitmask & (1 << i)]
    for L in letters:
        root = f"{L}:\\"
        dtype = ctypes.windll.kernel32.GetDriveTypeW(root)
        if dtype not in (2, 3, 4):  # 可移动/固定/网络
            continue
        name = root
        try:
            buf = ctypes.create_unicode_buffer(64)
            if ctypes.windll.kernel32.GetVolumeInformationW(root, buf, 64, None, None, None, None, 0):
                name = f"{buf.value or L+':'} ({L}:)"
        except Exception:
            pass
        total = free = 0
        try:
            free64 = ctypes.c_ulonglong(0); tot64 = ctypes.c_ulonglong(0)
            ctypes.windll.kernel32.GetDiskFreeSpaceExW(root, ctypes.byref(free64), ctypes.byref(tot64), None)
            free, total = free64.value, tot64.value
        except Exception:
            pass
        out.append({"name": name, "path": root, "type": {2: "removable", 3: "fixed", 4: "remote"}[dtype],
                    "total": total, "free": free})
    return out

def _shell_folder(guid_name):
    """读取用户 Shell 文件夹真实路径（处理 OneDrive 重定向）。"""
    try:
        import winreg
        key = winreg.OpenKey(winreg.HKEY_CURRENT_USER,
                             r"Software\Microsoft\Windows\CurrentVersion\Explorer\User Shell Folders")
        val, _ = winreg.QueryValueEx(key, guid_name)
        return os.path.expandvars(val)
    except Exception:
        return None

def special_paths():
    home = os.path.expanduser("~")
    desktop = _shell_folder("Desktop") or os.path.join(home, "Desktop")
    downloads = _shell_folder("{374DE290-123F-4565-9164-39C4925E467B}") or os.path.join(home, "Downloads")
    return {"home": home, "desktop": desktop, "downloads": downloads}

def open_terminal(path, kind="auto"):
    cwd = path if os.path.isdir(path) else os.path.dirname(path) or "."
    if kind in ("auto", None, ""):
        kind = "wt" if shutil.which("wt") else "powershell"
    if kind == "wt":
        subprocess.Popen(["wt", "-d", cwd], shell=False)
    elif kind == "cmd":
        subprocess.Popen("cmd.exe", cwd=cwd, creationflags=subprocess.CREATE_NEW_CONSOLE)
    elif kind == "powershell":
        subprocess.Popen("powershell.exe", cwd=cwd, creationflags=subprocess.CREATE_NEW_CONSOLE)
    else:
        subprocess.Popen(kind, cwd=cwd, shell=True)
    return True

ILLEGAL = re.compile(r'[\\/:*?"<>|]')

def unique_dest(dst):
    if not os.path.exists(dst):
        return dst
    base, ext = os.path.splitext(dst)
    for i in range(1, 999):
        cand = f"{base} - 副本{'' if i == 1 else f' ({i})'}{ext}"
        if not os.path.exists(cand):
            return cand
    return dst

# ─────────────────────── 本地预览服务 ───────────────────────
class _PVHandler(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass
    def _send_html(self, body, ctype="text/html; charset=utf-8", code=200):
        data = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)
    def do_GET(self):
        qs = parse_qs(urlparse(self.path).query)
        path = urlparse(self.path).path
        if path == "/ui":
            if qs.get("k", [""])[0] != PV.token:
                self._send_html("<h3>403</h3>", code=403)
                return
            self._send_html(load_html_cached())
            return
        if path == "/f":
            self._serve_file(qs)
            return
        self.send_error(404)
    def _serve_file(self, qs):
        if qs.get("k", [""])[0] != PV.token:
            self.send_error(403)
            return
        p = unquote(qs.get("p", [""])[0])
        if not os.path.isfile(p):
            self.send_error(404)
            return
        try:
            size = os.path.getsize(p)
            ctype = _mimetype(p)
            rng = self.headers.get("Range")
            f = open(p, "rb")
        except OSError:
            self.send_error(404)
            return
        with f:
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Accept-Ranges", "bytes")
            self.send_header("Cache-Control", "no-cache")
            start, end = 0, size - 1
            if rng:
                m = re.match(r"bytes=(\d*)-(\d*)", rng)
                if m:
                    if m.group(1):
                        start = int(m.group(1))
                    if m.group(2):
                        end = min(int(m.group(2)), size - 1)
                    self.send_response(206)
                    self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
            length = end - start + 1
            self.send_header("Content-Length", str(length))
            self.end_headers()
            f.seek(start)
            remaining = length
            while remaining > 0:
                chunk = f.read(min(65536, remaining))
                if not chunk:
                    break
                try:
                    self.wfile.write(chunk)
                except (ConnectionAbortedError, BrokenPipeError):
                    break
                remaining -= len(chunk)

def _mimetype(p):
    ext = os.path.splitext(p)[1].lower()
    table = {".md": "text/markdown", ".mp4": "video/mp4", ".mkv": "video/x-matroska",
             ".webm": "video/webm", ".webp": "image/webp", ".svg": "image/svg+xml",
             ".flac": "audio/flac", ".m4a": "audio/mp4", ".woff2": "font/woff2"}
    if ext in table:
        return table[ext]
    return mimetypes.guess_type(p)[0] or "application/octet-stream"

class PVServer:
    def __init__(self):
        self.token = secrets.token_hex(16)
        self.port = 0
        self.httpd = None
    def start(self):
        self.httpd = ThreadingHTTPServer(("127.0.0.1", 0), _PVHandler)
        self.httpd.daemon_threads = True
        self.port = self.httpd.server_address[1]
        threading.Thread(target=self.httpd.serve_forever, daemon=True).start()
    @property
    def base(self):
        return f"http://127.0.0.1:{self.port}"
    @property
    def ui_url(self):
        return f"{self.base}/ui?k={self.token}"
    def url(self, path):
        return f"{self.base}/f?k={self.token}&p=" + urlquote(path)

