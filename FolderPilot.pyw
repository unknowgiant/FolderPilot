TRACE_PATH = os.path.join(APP_DIR, "trace.log")

def _trace_has_init():
    try:
        with open(TRACE_PATH, "r", encoding="utf-8") as f:
            return "init-ok" in f.read()
    except OSError:
        return False

def _load_watchdog(win):
    """确认 UI 真实加载完成（以前端 init-ok 标记为准），否则重试导航。
    规避 WebView2 偶发的 about:blank 初始化竞态。首次加载给足 10s 宽限。"""
    t0 = time.time()
    while time.time() - t0 < 10 and not _trace_has_init():
        time.sleep(0.3)
    deadline = time.time() + 40
    while time.time() < deadline and not _trace_has_init():
        try:
            win.load_url(PV.ui_url)
        except Exception:
            pass
        t1 = time.time()
        while time.time() < t1 + 6 and not _trace_has_init():
            time.sleep(0.3)

def main():
    _single_instance_focus()
    os.makedirs(APP_DIR, exist_ok=True)
    PV.start()
    try:
        with open(TRACE_PATH, "w", encoding="utf-8") as f:
            f.write("")
    except OSError:
        pass
    import webview
    api = Api()
    # UI 通过内置本地服务以真实 URL 加载（避开 NavigateToString 大内容不稳定问题）
    win = webview.create_window(
        APP_TITLE, url=PV.ui_url, js_api=api,
        width=1280, height=820, min_size=(980, 620),
        background_color="#ffffff", confirm_close=False,
    )
    _apply_hotkey()
    def _bootstrap():
        threading.Thread(target=_load_watchdog, args=(win,), daemon=True).start()
    try:
        webview.start(_bootstrap, gui="edgechromium", debug=os.environ.get("FOLDERPILOT_DEBUG") == "1")
    except Exception:
        webview.start(_bootstrap, debug=os.environ.get("FOLDERPILOT_DEBUG") == "1")
    _unregister_hotkey()

if __name__ == "__main__":
    main()

