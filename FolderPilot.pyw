_cfg_lock = threading.Lock()

def _load_cfg():
    cfg = json.loads(json.dumps(DEFAULT_CFG))
    try:
        with open(CFG_PATH, "r", encoding="utf-8") as f:
            data = json.load(f)
        for k in cfg:
            if k in data:
                cfg[k] = data[k] if not isinstance(cfg[k], dict) else {**cfg[k], **data[k]}
        if "settings" in data:
            cfg["settings"].update(data["settings"])
    except Exception:
        pass
    return cfg

