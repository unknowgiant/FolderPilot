# ─────────────────────── 后台任务 ───────────────────────
JOBS = {}
_job_seq = [0]

def _new_job(total):
    _job_seq[0] += 1
    jid = f"job{_job_seq[0]}"
    JOBS[jid] = {"status": "running", "done": 0, "total": total, "current": "", "error": "", "cancel": False}
    return jid

def _run_transfer(paths, dest, move):
    total = len(paths)
    jid = _new_job(total)
    def worker():
        job = JOBS[jid]
        ok = 0
        try:
            os.makedirs(dest, exist_ok=True)
            for p in paths:
                if job["cancel"]:
                    job["error"] = "已取消"
                    break
                name = os.path.basename(p.rstrip("\\/"))
                job["current"] = name
                if not os.path.exists(p):
                    job["done"] += 1
                    continue
                dst = unique_dest(os.path.join(dest, name))
                if move:
                    if os.path.splitdrive(p)[0].lower() == os.path.splitdrive(dst)[0].lower():
                        os.rename(p, dst)
                    else:
                        shutil.move(p, dst)
                else:
                    if os.path.isdir(p):
                        shutil.copytree(p, dst)
                    else:
                        shutil.copy2(p, dst)
                ok += 1
                job["done"] += 1
            if not job["error"] and ok < total:
                job["error"] = f"{total - ok} 项跳过（源不存在）"
            job["status"] = "error" if job["error"] else "done"
        except Exception as e:
            job["status"] = "error"
            job["error"] = str(e)
    threading.Thread(target=worker, daemon=True).start()
    return jid

# ─────────────────────── 预览信息 ───────────────────────
ARCHIVE_EXTS = {".zip", ".jar", ".apk", ".whl", ".epub", ".cbz"}
CODE_EXTS = {".js", ".ts", ".jsx", ".tsx", ".py", ".java", ".c", ".cpp", ".h", ".hpp", ".cs", ".go",
             ".rs", ".php", ".rb", ".swift", ".kt", ".sql", ".ipynb", ".vbs", ".lua", ".r",
             ".json", ".xml", ".yaml", ".yml", ".toml", ".ini", ".cfg", ".css", ".scss", ".html", ".htm", ".bat", ".cmd", ".ps1", ".sh"}
TEXT_EXTS = {".txt", ".log", ".md", ".csv", ".tsv", ".srt", ".nfo", ".gitignore", ".env", ".url", ".m3u", ".list"}
IMAGE_EXTS = {".png", ".jpg", ".jpeg", ".gif", ".bmp", ".webp", ".svg", ".ico", ".avif", ".tif", ".tiff"}
VIDEO_EXTS = {".mp4", ".webm", ".mkv", ".mov", ".m4v"}
AUDIO_EXTS = {".mp3", ".wav", ".ogg", ".m4a", ".flac", ".aac"}

def _read_text_head(p, limit=TEXT_READ_LIMIT):
    raw = open(p, "rb").read(limit + 8)
    if raw.startswith(b"\xff\xfe") or raw.startswith(b"\xfe\xff"):
        return raw[:limit].decode("utf-16", "replace")
    if raw.startswith(b"\xef\xbb\xbf"):
        return raw[3:limit].decode("utf-8", "replace")
    try:
        return raw[:limit].decode("utf-8")
    except UnicodeDecodeError:
        return raw[:limit].decode("gbk", "replace")

def _attrs_of(p):
    try:
        a = os.stat(p).st_file_attributes
    except Exception:
        return []
    out = []
    if a & 0x1: out.append("只读")
    if a & 0x2: out.append("隐藏")
    if a & 0x4: out.append("系统")
    if a & 0x20: out.append("存档")
    if a & 0x400: out.append("压缩")
    if a & 0x800: out.append("加密")
    return out

def _file_kind(p):
    ext = os.path.splitext(p)[1].lower()
    if ext == ".pdf": return "pdf"
    if ext in IMAGE_EXTS: return "image"
    if ext in VIDEO_EXTS: return "video"
    if ext in AUDIO_EXTS: return "audio"
    if ext in ARCHIVE_EXTS: return "zip"
    if ext == ".md" or ext == ".markdown": return "markdown"
    if ext in CODE_EXTS: return "code"
    if ext in TEXT_EXTS: return "text"
    return "other"

def preview_info(path):
    if not os.path.exists(path):
        return {"error": "文件不存在"}
    kind = _file_kind(path)
    try:
        st = os.stat(path)
    except OSError as e:
        return {"error": str(e)}
    r = {"kind": kind, "name": os.path.basename(path), "ext": os.path.splitext(path)[1].lstrip("."),
         "size": st.st_size if os.path.isfile(path) else 0, "mtime": st.st_mtime,
         "is_dir": os.path.isdir(path), "attrs": _attrs_of(path), "url": None, "text": None, "zip": None}
    if kind in ("image", "video", "audio", "pdf") and os.path.isfile(path):
        if kind == "image" and st.st_size > PREVIEW_MAX_IMAGE:
            r["kind"] = "other"
        else:
            r["url"] = PV.url(path)
    elif kind in ("text", "code", "markdown") and os.path.isfile(path):
        try:
            r["text"] = _read_text_head(path)
        except Exception as e:
            r["text"] = f"(无法读取: {e})"
    elif kind == "zip" and os.path.isfile(path):
        try:
            entries = []
            with zipfile.ZipFile(path) as z:
                infos = z.infolist()[:2000]
                for zi in infos:
                    nm = zi.filename
                    try:
                        nm = nm.encode("cp437").decode("gbk")
                    except (UnicodeEncodeError, UnicodeDecodeError):
                        try:
                            nm = nm.encode("cp437").decode("utf-8")
                        except Exception:
                            pass
                    entries.append({"name": nm, "is_dir": zi.is_dir(),
                                    "size": 0 if zi.is_dir() else zi.file_size})
            r["zip"] = entries
        except Exception as e:
            r["kind"] = "other"
            r["zip_error"] = str(e)
    return r

def _diff_rows(a_lines, b_lines, sm):
    rows = []
    ins = dele = eq = 0
    for tag, i1, i2, j1, j2 in sm.get_opcodes():
        if tag == "equal":
            for k in range(i2 - i1):
                rows.append({"k": "eq", "a": i1 + k + 1, "b": j1 + k + 1, "ta": a_lines[i1 + k], "tb": b_lines[j1 + k]})
                eq += 1
        elif tag == "delete":
            for k in range(i2 - i1):
                rows.append({"k": "del", "a": i1 + k + 1, "b": None, "ta": a_lines[i1 + k], "tb": None})
                dele += 1
        elif tag == "insert":
            for k in range(j2 - j1):
                rows.append({"k": "ins", "a": None, "b": j1 + k + 1, "ta": None, "tb": b_lines[j1 + k]})
                ins += 1
        else:  # replace
            na, nb = i2 - i1, j2 - j1
            for k in range(max(na, nb)):
                ta = a_lines[i1 + k] if k < na else None
                tb = b_lines[j1 + k] if k < nb else None
                if k < na and k < nb:
                    rows.append({"k": "rep", "a": i1 + k + 1, "b": j1 + k + 1, "ta": ta, "tb": tb})
                    dele += 1
                elif k < na:
                    rows.append({"k": "del", "a": i1 + k + 1, "b": None, "ta": ta, "tb": None})
                    dele += 1
                else:
                    rows.append({"k": "ins", "a": None, "b": j1 + k + 1, "ta": None, "tb": tb})
                    ins += 1
    return rows, ins, dele, eq

