            os.makedirs(APP_DIR, exist_ok=True)
            tmp = CFG_PATH + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(CFG, f, ensure_ascii=False, indent=1)
            os.replace(tmp, CFG_PATH)
        except Exception as e:
            print("save_cfg:", e, file=sys.stderr)

