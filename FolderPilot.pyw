    def ensure_everything(self, auto_start=True):
        """检测 Everything；未运行且允许时自动尝试启动并等待连接。"""
        global _LAST_EV_START
        st = self.everything_status()
        if st.get("backend") != "none":
            st["note"] = "already"
            return st
        if not auto_start:
            return st
        now = time.time()
        if now - _LAST_EV_START < 60:
            st["error"] = "Everything 未运行（自动启动冷却中，稍后重试）"
            return st
        exe = find_everything_exe()
        if not exe:
            st["error"] = "未找到 Everything，请安装 voidtools Everything 后重试"
            return st
        _LAST_EV_START = now
        try:
            flags = 0x00000008 | 0x00000200  # DETACHED_PROCESS | CREATE_NEW_PROCESS_GROUP
            subprocess.Popen([exe], creationflags=flags, close_fds=True)
        except Exception as e:
            st["error"] = "启动 Everything 失败：" + str(e)
            return st
        for _ in range(25):
            time.sleep(0.4)
            st = self.everything_status()
            if st.get("backend") != "none":
                st["note"] = "autostarted"
                return st
        st["error"] = "已尝试启动 Everything，但尚未就绪，请稍后点状态栏重试"
        return st
    def everything_search(self, filters, kw, opts=None):
        opts = opts or {}
        maxn = int(opts.get("max") or CFG["settings"].get("ev_max") or 300)
        t0 = time.time()
        kw = (kw or "").strip()
        kw_term = kw
        content = bool(opts.get("content"))
        if kw_term and (" " in kw_term or content):
            kw_term = f'content:"{kw_term}"' if content else f'"{kw_term}"'
        elif kw_term and content:
            kw_term = f'content:"{kw_term}"'
        q = (filters or "").strip()
        if kw_term:
            q = (q + " " + kw_term).strip()
        backend = "dll" if EV.dll or EV.connect() else None
        note = ""
        try:
            if backend == "dll":
                res = EV.search(q, maxn)
                # 拼音二次查询（Everything 1.5 alpha）
                if (opts.get("pinyin") and EV.pinyin_ok and not content
                        and re.fullmatch(r"[a-zA-Z][a-zA-Z0-9_-]*", kw or "")):
                    q2 = (filters + " pinyin:" + kw).strip()
                    try:
                        seen = {os.path.join(r["path"], r["name"]).lower() for r in res}
                        for r in EV.search(q2, maxn):
                            k2 = os.path.join(r["path"], r["name"]).lower()
                            if k2 not in seen:
                                res.append(r)
                    except RuntimeError:
                        pass
            else:
                res = _http_search(q, maxn)
                backend = "http"
        except RuntimeError as e:
            if backend == "dll" and ("未运行" in str(e)):
                # 自动启动 Everything 后重试一次（受设置开关控制）
                st2 = self.ensure_everything(bool(CFG["settings"].get("auto_start_ev", True)))
                if st2.get("backend") == "dll":
                    try:
                        res = EV.search(q, maxn)
                        backend = "dll"
                        note = "已自动启动 Everything"
                    except RuntimeError:
                        res = None
                if not res:
                    try:
                        res = _http_search(q, maxn)
                        backend = "http"
                    except Exception as e2:
                        res = _local_fallback_search(filters, kw, opts.get("dir"), maxn)
                        backend = "local"
                        note = "Everything 不可用，已用本地搜索"
            else:
                res = _local_fallback_search(filters, kw, opts.get("dir"), maxn)
                backend = "local"
                note = str(e) + "，已用本地搜索"
        for r in res:
            try:
                r["is_dir"] = os.path.isdir(os.path.join(r["path"], r["name"]))
                if r["is_dir"]:
                    r["size"] = 0
            except OSError:
                pass
        elapsed = int((time.time() - t0) * 1000)
        return {"results": res[:maxn], "total": len(res), "elapsed": elapsed,
                "backend": backend, "note": note}
    def preview_info(self, path):
        return preview_info(path)
    def zip_extract(self, path, dest, entries=None):
        try:
            with zipfile.ZipFile(path) as z:
                names = entries if entries else z.namelist()
        except Exception as e:
            return {"ok": False, "error": str(e)}
        jid = _new_job(len(names))
        def worker():
            job = JOBS[jid]
            try:
                os.makedirs(dest, exist_ok=True)
                with zipfile.ZipFile(path) as z:
                    for nm in names:
                        if job["cancel"]:
                            job["error"] = "已取消"
                            break
                        job["current"] = nm
                        try:
                            fixed = nm
                            try:
                                fixed = nm.encode("cp437").decode("gbk")
                            except (UnicodeEncodeError, UnicodeDecodeError):
                                pass
                            target = os.path.join(dest, *fixed.replace("\\", "/").split("/"))
                            if nm.endswith("/"):
                                os.makedirs(target, exist_ok=True)
                            else:
                                os.makedirs(os.path.dirname(target), exist_ok=True)
                                with z.open(nm) as src, open(target, "wb") as out:
                                    shutil.copyfileobj(src, out)
                        except Exception as e:
                            job["error"] = f"{nm}: {e}"
                            break
                        job["done"] += 1
                job["status"] = "error" if job["error"] else "done"
            except Exception as e:
                job["status"] = "error"
                job["error"] = str(e)
        threading.Thread(target=worker, daemon=True).start()
        return {"ok": True, "job": jid}
    def zip_create(self, paths, dest_zip):
        """将选中的文件/文件夹打包为 ZIP（目录递归，后台任务带进度）。"""
        try:
            if not paths:
                return {"ok": False, "error": "未选择要压缩的项目"}
            if os.path.exists(dest_zip):
                return {"ok": False, "error": "同名压缩包已存在：" + os.path.basename(dest_zip)}
            items = []  # (绝对路径, 归档内路径 posix)
            for p in paths:
                if not os.path.exists(p):
                    continue
                if os.path.isdir(p):
                    base = os.path.dirname(p.rstrip("\\/"))
                    items.append((p, os.path.basename(p.rstrip("\\/")) + "/"))
                    for r, dirs, files in os.walk(p):
                        for n in dirs:
                            rel = os.path.relpath(os.path.join(r, n), base).replace("\\", "/")
                            items.append((os.path.join(r, n), rel + "/"))
                        for n in files:
                            rel = os.path.relpath(os.path.join(r, n), base).replace("\\", "/")
                            items.append((os.path.join(r, n), rel))
                else:
                    items.append((p, os.path.basename(p)))
            if not items:
                return {"ok": False, "error": "没有可压缩的内容"}
            jid = _new_job(len(items))
            def worker():
                job = JOBS[jid]
                try:
                    with zipfile.ZipFile(dest_zip, "w", zipfile.ZIP_DEFLATED, allowZip64=True) as zf:
                        for ap, arc in items:
                            if job["cancel"]:
                                job["error"] = "已取消"
                                break
                            job["current"] = arc
                            try:
                                if arc.endswith("/"):
                                    zf.writestr(arc, "")
                                else:
                                    zf.write(ap, arc)
                            except Exception as e:
                                job["error"] = f"{arc}: {e}"
                                break
                            job["done"] += 1
                    if job["error"]:
                        job["status"] = "error"
                        try:
                            os.remove(dest_zip)
                        except OSError:
                            pass
                    else:
                        job["status"] = "done"
                except Exception as e:
                    job["status"] = "error"
                    job["error"] = str(e)
                    try:
                        os.remove(dest_zip)
                    except OSError:
                        pass
            threading.Thread(target=worker, daemon=True).start()
            return {"ok": True, "job": jid}
        except Exception as e:
            return {"ok": False, "error": str(e)}
    def restart_admin(self):
        """以管理员身份重新启动本程序（触发 UAC 确认）。"""
        try:
            exe = sys.executable
            if getattr(sys, "frozen", False):
                params = "--elevated-restart"
            else:
                script = os.path.abspath(sys.argv[0])
                params = '"%s" --elevated-restart' % script
            rc = ctypes.windll.shell32.ShellExecuteW(None, "runas", exe, params, None, 1)
            if rc <= 32:
                return {"ok": False, "error": "已取消或提权失败（代码 %s）" % rc}
            def _quit():
                try:
                    os._exit(0)
                except Exception:
                    pass
            threading.Timer(0.4, _quit).start()
            return {"ok": True}
        except Exception as e:
            return {"ok": False, "error": str(e)}
    def run_as_admin(self, path):
        """以管理员身份运行指定可执行文件（触发 UAC 确认）。"""
        try:
            if not os.path.isfile(path):
                return {"ok": False, "error": "文件不存在"}
            rc = ctypes.windll.shell32.ShellExecuteW(None, "runas", path, None, None, 1)
            if rc <= 32:
                return {"ok": False, "error": "已取消或提权失败（代码 %s）" % rc}
            return {"ok": True}
        except Exception as e:
            return {"ok": False, "error": str(e)}
    def text_diff(self, path_a, path_b, ignore_ws=False, ignore_case=False):
        try:
            a = _read_text_head(path_a, DIFF_READ_LIMIT)
            b = _read_text_head(path_b, DIFF_READ_LIMIT)
        except OSError as e:
            return {"error": str(e)}
        a_lines = a.splitlines()
        b_lines = b.splitlines()
        def norm(s):
            s2 = s.rstrip() if ignore_ws else s
            return s2.lower() if ignore_case else s2
        sm = difflib.SequenceMatcher(a=[norm(x) for x in a_lines], b=[norm(y) for y in b_lines], autojunk=False)
        rows, ins, dele, eq = _diff_rows(a_lines, b_lines, sm)
        return {"rows": rows, "la": len(a_lines), "lb": len(b_lines), "ins": ins, "del": dele, "eq": eq}
    def folder_compare(self, dir_a, dir_b, recursive=False, max_depth=1):
        def scan(root):
            out = {}
            base_len = len(root.rstrip("\\/")) + 1
            if recursive:
                for r, dirs, files in os.walk(root):
                    depth = r[base_len:].count(os.sep) if len(r) > base_len else 0
                    if depth >= max_depth:
                        dirs[:] = []
                    for n in dirs:
                        rel = os.path.relpath(os.path.join(r, n), root)
                        out[rel.replace(os.sep, "/") + "/"] = (0, None, True)
                    for n in files:
                        full = os.path.join(r, n)
                        try:
                            st = os.stat(full)
                            out[os.path.relpath(full, root).replace(os.sep, "/")] = (st.st_size, st.st_mtime, False)
                        except OSError:
                            pass
            else:
                try:
                    with os.scandir(root) as it:
                        for e in it:
                            try:
                                st = e.stat(follow_symlinks=False)
                                if e.is_dir(follow_symlinks=False):
                                    out[e.name + "/"] = (0, None, True)
                                else:
                                    out[e.name] = (st.st_size, st.st_mtime, False)
                            except OSError:
                                pass
                except OSError:
                    pass
            return out
        ma, mb = scan(dir_a), scan(dir_b)
        rows = []
        for rel in sorted(set(ma) | set(mb)):
            ea, eb = ma.get(rel), mb.get(rel)
            if ea and eb:
                status = "same" if ea == eb else "diff"
                rows.append({"rel": rel, "status": status,
                             "sizeA": None if ea[2] else ea[0], "sizeB": None if eb[2] else eb[0],
                             "mtimeA": ea[1], "mtimeB": eb[1]})
            elif ea:
                rows.append({"rel": rel, "status": "only_a",
                             "sizeA": None if ea[2] else ea[0], "sizeB": None, "mtimeA": ea[1], "mtimeB": None})
            else:
                rows.append({"rel": rel, "status": "only_b",
                             "sizeA": None, "sizeB": None if eb[2] else eb[0], "mtimeA": None, "mtimeB": eb[1]})
            if len(rows) >= 5000:
                break
        return {"rows": rows}
    def export_csv(self, kind):
        import csv
        os.makedirs(EXPORT_DIR, exist_ok=True)
        fn = os.path.join(EXPORT_DIR, f"{kind}-{time.strftime('%Y%m%d-%H%M%S')}.csv")
        with open(fn, "w", encoding="utf-8-sig", newline="") as f:
            w = csv.writer(f)
            if kind == "tags":
                w.writerow(["路径", "标签"])
                for p, colors in CFG["tags"].items():
                    w.writerow([p, ";".join(colors)])
            elif kind == "staging":
                w.writerow(["路径", "加入方式"])
                for p in CFG["staging"].get("items", []):
                    w.writerow([p, CFG["staging"].get("mode", "copy")])
            elif kind == "bookmarks":
                w.writerow(["名称", "路径"])
                for b in CFG["bookmarks"]:
                    w.writerow([b.get("name", ""), b.get("path", "")])
            elif kind == "history":
                w.writerow(["搜索词"])
                for h in CFG["history"]:
                    w.writerow([h])
            else:
                return {"ok": False, "error": "未知导出类型"}
        return {"ok": True, "path": fn}

# ─────────────────────── 全局热键 / 单实例 ───────────────────────
WM_HOTKEY = 0x0312
MOD_ALT, MOD_NOREPEAT = 0x0001, 0x4000
VK_SPACE = 0x20
HOTKEY_ID = 0xC001
_hotkey_registered = [False]
_hotkey_tid = [0]

def _hotkey_loop(on_hotkey):
    try:
        if not ctypes.windll.user32.RegisterHotKey(None, HOTKEY_ID, MOD_ALT | MOD_NOREPEAT, VK_SPACE):
            return
        _hotkey_registered[0] = True
        _hotkey_tid[0] = ctypes.windll.kernel32.GetCurrentThreadId()
        msg = wintypes.MSG()
        while ctypes.windll.user32.GetMessageW(ctypes.byref(msg), None, 0, 0) > 0:
            if msg.message == WM_HOTKEY and msg.wParam == HOTKEY_ID:
                try:
                    on_hotkey()
                except Exception:
                    pass
        _hotkey_registered[0] = False
    except Exception:
        pass

def _unregister_hotkey():
    if _hotkey_registered[0]:
        ctypes.windll.user32.UnregisterHotKey(None, HOTKEY_ID)
        if _hotkey_tid[0]:
            ctypes.windll.user32.PostThreadMessageW(_hotkey_tid[0], 0x0012, 0, 0)  # WM_QUIT
        _hotkey_registered[0] = False

def _apply_hotkey():
    """根据配置启停 Alt+Space 全局热键。"""
    if TEST_MODE:
        return  # 无头自测：不注册全局热键
    enabled = CFG["settings"].get("hotkey", True)
    if _hotkey_registered[0] and not enabled:
        _unregister_hotkey()
    elif not _hotkey_registered[0] and enabled:
        threading.Thread(target=_hotkey_loop, args=(_focus_and_search,), daemon=True).start()

Api._apply_hotkey_setting = lambda self: _apply_hotkey()

def _focus_and_search():
    try:
        win = webview.windows[0] if "webview" in globals() and webview.windows else None
    except Exception:
        win = None
    if win:
        try:
            win.show()
            win.evaluate_js("window.__fpHotkey && __fpHotkey()")
        except Exception:
            pass

def find_everything_exe():
    """尝试定位 Everything 主程序（注册表 → 卸载信息 → 常见路径）。"""
    try:
        import winreg
        cand_vals = []
        for root in (winreg.HKEY_LOCAL_MACHINE, winreg.HKEY_CURRENT_USER):
            for key in (r"SOFTWARE\Everything", r"SOFTWARE\WOW6432Node\Everything"):
                try:
                    with winreg.OpenKey(root, key) as k:
                        for vn in ("InstallPath", "Install Path", "Location"):
                            try:
                                cand_vals.append(str(winreg.QueryValueEx(k, vn)[0]))
                            except OSError:
                                pass
                except OSError:
                    pass
            for key in (r"SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Everything",
                        r"SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\Everything"):
                try:
                    with winreg.OpenKey(root, key) as k:
                        try:
                            cand_vals.append(str(winreg.QueryValueEx(k, "InstallLocation")[0]))
                        except OSError:
                            pass
                        try:
                            us = str(winreg.QueryValueEx(k, "UninstallString")[0]).strip().strip('"')
                            if us:
                                if os.path.basename(us).lower() in ("uninstall.exe", "uninstall64.exe", "unins000.exe"):
                                    us = os.path.dirname(us)
                                cand_vals.append(us)
                        except OSError:
                            pass
                except OSError:
                    pass
        for v in cand_vals:
            v = v.strip().strip('"')
            if not v:
                continue
            if os.path.isfile(v) and v.lower().endswith(".exe") and "everything" in os.path.basename(v).lower():
                return v
            for n in ("Everything.exe", "Everything64.exe"):
                p = os.path.join(v, n)
                if os.path.exists(p):
                    return p
    except Exception:
        pass
    import os
    la = os.environ.get("LOCALAPPDATA", "")
    pf = os.environ.get("ProgramFiles", r"C:\Program Files")
    pf86 = os.environ.get("ProgramFiles(x86)", r"C:\Program Files (x86)")
    for p in (os.path.join(pf, "Everything", "Everything.exe"),
              os.path.join(pf86, "Everything", "Everything.exe"),
              os.path.join(la, "Everything", "Everything.exe")):
        try:
            if os.path.exists(p):
                return p
        except OSError:
            pass
    # 兜底：从正在运行的 Everything 进程取可执行文件路径（WMI）
    try:
        out = subprocess.check_output(
            ["powershell", "-NoProfile", "-Command",
             "[Console]::OutputEncoding=[Text.Encoding]::UTF8;"
             "(Get-Process Everything -ErrorAction SilentlyContinue | Where-Object {$_.Path} | Select-Object -First 1 -ExpandProperty Path)"],
            timeout=15, creationflags=0x08000000)
        p = out.decode("utf-8", "ignore").strip()
        if p and os.path.isfile(p):
            return p
    except Exception:
        pass
    return None

_LAST_EV_START = 0.0

def _single_instance_focus():
    """已有实例时将其置前并退出；提权重启场景下先等待旧实例退出。"""
    if TEST_MODE:
        return  # 无头自测：不碰单实例互斥体，避免干扰正在运行的真实实例
    elevated = "--elevated-restart" in sys.argv
    mutex = ctypes.windll.kernel32.CreateMutexW(None, False, "FolderPilot.SingleInstance")
    if ctypes.windll.kernel32.GetLastError() == 183:
        if elevated:
            for _ in range(60):
                time.sleep(0.25)
                try:
                    ctypes.windll.kernel32.CloseHandle(mutex)
                except Exception:
                    pass
                mutex = ctypes.windll.kernel32.CreateMutexW(None, False, "FolderPilot.SingleInstance")
                if ctypes.windll.kernel32.GetLastError() != 183:
                    return  # 旧实例已退出，互斥体已归本进程，继续正常启动
        hwnd = ctypes.windll.user32.FindWindowW(None, APP_TITLE)
        if hwnd:
            ctypes.windll.user32.ShowWindow(hwnd, 9)  # SW_RESTORE
            ctypes.windll.user32.SetForegroundWindow(hwnd)
        sys.exit(0)

